# Ferramentas do Harness para macOS. Uso:
#   curl -fsSLO https://raw.githubusercontent.com/EltonMC/harness-for-noobs/main/Brewfile && brew bundle
brew "git"
brew "node"          # Node.js 22 ou mais novo
brew "pnpm"          # gerenciador de pacotes da aplicação (10+)
brew "uv"            # roda o Copier e o BMad
brew "gh"            # GitHub CLI: pull requests e proteção da main
brew "gitleaks"      # detector extra de segredos nos commits
tap "supabase/tap"
brew "supabase/tap/supabase"
cask "docker-desktop" # necessário para o Supabase local
