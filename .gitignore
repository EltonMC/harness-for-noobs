# Secrets and local environment
.env
.env.*
!.env.example
.dev.vars

# JavaScript and build artifacts
node_modules/
dist/
coverage/
playwright-report/
test-results/
.wrangler/

# Supabase local state
supabase/.temp/
supabase/.branches/

# Generated planning, evidence, logs, and Impeccable runtime artifacts
_bmad-output/
.harness/evidence/*.md
.harness/logs/
.harness/.managed-adapters.json
.harness/.local-state.json
.harness/.skill-cache/
.harness/.update-backup/
.impeccable/

# Project-local BMad runtime; recreate it with `npm run harness -- setup`.
_bmad/

# Installed skills are generated per agent by `npm run harness -- setup`.
# Agent settings, hooks, and Harness subagents stay versioned.
.agents/
.cline/
.cursor/
.devin/
.github/skills/
.claude/skills/
.claude/agents/*
!.claude/agents/harness-*.md
.claude/settings.local.json
.claude/worktrees/

# Copier update conflict leftovers
*.rej
*.orig

# OS and editor noise
.DS_Store
*.swp
*.swo
